# Copie para .env e ajuste os valores locais.
APP_NAME=meuSaldo API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://meusaldo:meusaldo@localhost:15432/meusaldo
CORS_ORIGINS=http://localhost:5173

# Segurança: use uma chave forte e exclusiva em produção.
SECRET_KEY=meusaldo-dev-secret-troque-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Recuperação de senha (T-026): em dev os e-mails aparecem no log ("console");
# em produção use EMAIL_BACKEND=smtp e configure as variáveis SMTP.
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@meusaldo.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
